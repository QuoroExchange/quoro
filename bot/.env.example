# X app keys for the reply account (OAuth 1.0a, Read and Write, minted after the permission was set)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_HANDLE=QuoroAI
# where token answers come from
QUORO_API=https://quoro.exchange
# 1 = do everything except the X calls and print the reply instead
DRY_RUN=1
# optional: POLL_SEC=20  MAX_PER_HOUR  MAX_PER_AUTHOR_DAY  BOT_STATE=bot-state.json
