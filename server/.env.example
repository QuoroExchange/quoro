# Copy to server/.env (local) or set as service variables (production). Never commit real values.

# Required
ENGINE_URL=            # the launch data engine: /api/check, /api/tops, /api/feed, /api/stats, candles
PRIVY_APP_ID=          # public Privy app id (wallet connection only)

# Strongly recommended
LIFI_KEY=              # LI.FI API key: without it quotes are limited per IP (75 per 2 hours)
RELAY_KEY=             # Relay API key
OPENROUTER_API_KEY=    # Quoro AI (score explanations); without it the AI lines are hidden

# Optional
ALCHEMY_KEY=           # lets the portfolio see every token a wallet holds on Robinhood Chain
SITE_URL=              # public address, e.g. https://quoro.exchange (absolute og:image / og:url)
LLM_MODEL=             # default: anthropic/claude-haiku-5.5
RPC_URL=               # Robinhood Chain RPC, default: the official node
PORT=8795
